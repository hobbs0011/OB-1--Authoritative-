{
  // Backup of original Kilo config created 2026-04-05
  // If you need to restore, copy this content back to kilo.jsonc
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "mcp": {
    "servers": {
      "azure-mcp": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-azure-resources"]
      },
      "github-mcp": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-github"]
      },
      "filesystem-mcp": {
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:/Users/mrmic/Desktop"]
      }
    }
  },
  "skills": [
    "C:/Users/mrmic/.agents/skills"
  ],
  "agents": {
    "default": {
      "model": "claude-sonnet-4-20250514",
      "temperature": 0.7,
      "maxTokens": 8000
    }
  },
  "output": {
    "verbose": true,
    "showToolCalls": false,
    "showThinking": false
  }
}
