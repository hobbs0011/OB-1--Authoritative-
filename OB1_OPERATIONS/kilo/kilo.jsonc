{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "gh *": "allow",
      "gh auth *": "allow",
      "gh auth status *": "allow"
    },
    "read": "allow",
    "edit": {
      "*": "allow"
    },
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "C:/Users/mrmic/.vscode-insiders/extensions/*": "allow",
      "C:/Users/mrmic/.agents/skills/*": "allow",
      "C:/Users/mrmic/*": "allow"
    },
    "doom_loop": "allow"
  },
  "skills": {
    "paths": [
      "C:/Users/mrmic/.agents/skills"
    ]
  },
  "agent": {
    "plan": {
      "model": "kilo/kilo-auto/balanced"
    },
    "code": {
      "model": "kilo/kilo-auto/free"
    }
  },
  "model": "kilo/kilo-auto/free",
  "small_model": "kilo/kilo-auto/free",
  "username": "Hobbs"
}