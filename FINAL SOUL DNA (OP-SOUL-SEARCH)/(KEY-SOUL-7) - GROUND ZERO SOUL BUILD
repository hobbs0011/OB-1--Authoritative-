{"id": "SOULDNA_SEG_000720", "label": "user", "confidence": 0.55, "source": {"file": "SOULDNA-FROMSCRATCH.txt", "line_start": 3410, "line_end": 3410, "char_start": 194454, "char_end": 194599, "block_index": 719}, "text": "Merkle Consolidation: Instead of Obi and Anakin holding two full copies of the same 1-hour probe droid data, they now hold a single shared hash.", "sha256": "dac33e8223579c09ef6f335e9c5c0b1123299c12c4bb0f50f23142c56760ae09", "redactions": 0, "explicit_marker_used": false}
