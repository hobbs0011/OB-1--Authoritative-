{"id": "SOULDNA_SEG_000693", "label": "user", "confidence": 0.55, "source": {"file": "SOULDNA-FROMSCRATCH.txt", "line_start": 3340, "line_end": 3340, "char_start": 190455, "char_end": 190580, "block_index": 692}, "text": "Each Master Node (Anakin/Obi) manages 3 Padawans. For a team of 10 drones, we distribute them into specialized mission sets:", "sha256": "c3a1e8753b5b4bbd6587c9a0f15c84d806c67a4271c33fa0efe906f95677edc0", "redactions": 0, "explicit_marker_used": false}
