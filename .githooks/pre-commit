#!/usr/bin/env bash
set -euo pipefail

# Block common secret leaks before commit.
BLOCKED=0

staged_files=$(git diff --cached --name-only --diff-filter=ACMRTUXB)
if [[ -z "${staged_files}" ]]; then
  exit 0
fi

# Always block explicit secret-bearing files.
blocked_path_pattern='(^|/|\\)(\.env(\.|$)|\.env\.keys$|.*\.(pem|p12|pfx|key)$)'
if echo "${staged_files}" | grep -E -i "${blocked_path_pattern}" >/dev/null; then
  echo "[secret-guard] Secret-bearing file type detected in staged changes."
  echo "${staged_files}" | grep -E -i "${blocked_path_pattern}" | sed 's/^/[secret-guard]   /'
  BLOCKED=1
fi

# High-signal patterns for credentials and private keys.
secret_pattern='(DOTENV_PRIVATE_KEY\s*=|BEGIN[[:space:]]+([A-Z]+[[:space:]]+)?PRIVATE[[:space:]]+KEY|API[_-]?KEY[[:space:]]*[:=][[:space:]]*["\x27]?[A-Za-z0-9_\-]{16,}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9]{20,}|AIza[0-9A-Za-z\-_]{35}|xox[baprs]-[A-Za-z0-9-]{10,})'

while IFS= read -r file; do
  [[ -z "${file}" ]] && continue

  # Avoid self-referential matches in scanner definitions.
  if [[ "${file}" == ".githooks/pre-commit" || "${file}" == ".github/workflows/secret-scan.yml" ]]; then
    continue
  fi

  # Skip removed files and skip binary blobs.
  if ! git cat-file -e ":${file}" 2>/dev/null; then
    continue
  fi
  if ! git show ":${file}" | grep -Iq .; then
    continue
  fi

  added_lines=$(git diff --cached -U0 -- "${file}" | grep -E '^\+[^+]' || true)
  if [[ -z "${added_lines}" ]]; then
    continue
  fi

  if echo "${added_lines}" | grep -E -n "${secret_pattern}" >/dev/null; then
    echo "[secret-guard] Potential secret detected in ${file}"
    echo "${added_lines}" | grep -E -n "${secret_pattern}" | sed 's/^/[secret-guard]   /'
    BLOCKED=1
  fi
done <<< "${staged_files}"

if [[ ${BLOCKED} -ne 0 ]]; then
  echo "[secret-guard] Commit blocked. Remove secrets or move them to Wrangler/GitHub secrets."
  exit 1
fi

exit 0
