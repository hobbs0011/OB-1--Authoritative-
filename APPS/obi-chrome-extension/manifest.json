{
  "manifest_version": 3,
  "name": "OBI — Natural English Training",
  "version": "0.3.0",
  "description": "Your AI English tutor + homework checker + vocab flashcards. Mouse → Tiger. Permission over perfection.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "contextMenus",
    "tts"
  ],
  "host_permissions": [
    "https://net-pet-ai.mrmichaelhobbs123.workers.dev/*",
    "https://naturalenglishtraining.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "120"
}