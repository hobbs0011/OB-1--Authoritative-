rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Student profiles — authenticated users can read/write their own
    match /students/{studentId} {
      allow read, write: if request.auth != null && request.auth.uid == studentId;
    }

    // Lesson progress — authenticated users can read/write their own
    match /students/{studentId}/progress/{lessonId} {
      allow read, write: if request.auth != null && request.auth.uid == studentId;
    }

    // Public lessons — anyone can read, only admin can write
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Teacher dashboard — admin only
    match /admin/{document=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
