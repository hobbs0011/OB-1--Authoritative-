{
  "name": "net-pet-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "set BROWSER=none&& wrangler dev --port 8788",
    "dev:safe": "set BROWSER=none&& wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "deploy:safe": "node -e \"if(!process.env.CLOUDFLARE_API_TOKEN){console.error('Missing CLOUDFLARE_API_TOKEN');process.exit(1)}\" && wrangler deploy",
    "verify:wrangler": "npx wrangler deploy --dry-run --outdir dist/dry-run",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20260601.0",
    "drizzle-kit": "^0.30.6",
    "drizzle-orm": "^0.44.7",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.38.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.83.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.14",
    "hono": "^4.12.23"
  }
}
