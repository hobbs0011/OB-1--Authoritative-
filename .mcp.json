{
  // NET | Phoenix Rising Protocol — MCP Servers
  // Stack: Cloudflare, GitHub, Notion, Playwright, Chrome, Slack, FS, Brave, Discord,
  //        Telegram, LinkedIn, Gmail, Outlook, Roblox
  // Updated: 2026-04-14 | Run 281+ | Empire Command Stack
  // TOKEN STATUS: CF/GH/Notion/Roblox = SET | Slack/Discord/Brave/TG/LI/Gmail/Outlook = needs token
  "servers": {

    // ── CLOUDFLARE ─── SET ✓ ─────────────────────────────────────────────────
    "cloudflare": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cloudflare/mcp-server-cloudflare"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${env:CLOUDFLARE_API_TOKEN}",
        "CLOUDFLARE_API_KEY": "${env:CLOUDFLARE_API_KEY}",
        "CLOUDFLARE_EMAIL": "${env:CLOUDFLARE_EMAIL}",
        "CLOUDFLARE_ACCOUNT_ID": "${env:CLOUDFLARE_ACCOUNT_ID}"
      }
    },

    // ── GITHUB ─── SET ✓ ─────────────────────────────────────────────────────
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}"
      }
    },

    // ── NOTION ─── SET ✓ ─────────────────────────────────────────────────────
    "notion": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${env:NOTION_TOKEN}"
      }
    },

    // ── PLAYWRIGHT (browser automation + Facebook) ────────────────────────
    // Facebook has no official MCP; Playwright is the automation layer for FB ops
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--headless"]
    },

    // ── CHROME DEVTOOLS ───────────────────────────────────────────────────
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp"]
    },

    // ── FILESYSTEM ────────────────────────────────────────────────────────
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\mrmic\\Desktop\\OB-1"
      ]
    },

    // ── ROBLOX ─── SET ✓ ──────────────────────────────────────────────────
    "roblox": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@weppy/roblox-mcp"],
      "env": {
        "ROBLOX_API_KEY": "${env:ROBLOX_API_KEY}"
      }
    },
    "roblox-studio": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "robloxstudio-mcp"]
    },

    // ── SLACK ─── TOKEN NEEDED ────────────────────────────────────────────
    // Get token: api.slack.com/apps → Create App → Bot Token Scopes: channels:read,
    // chat:write, users:read → Install to workspace → copy xoxb- token
    "slack": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${env:SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${env:SLACK_TEAM_ID}"
      }
    },

    // ── DISCORD ─── TOKEN NEEDED ──────────────────────────────────────────
    // Get token: discord.com/developers/applications → New App → Bot → Reset Token
    // Scopes: bot | Permissions: Send Messages, Read Message History
    "discord": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-discord"],
      "env": {
        "DISCORD_TOKEN": "${env:DISCORD_TOKEN}"
      }
    },

    // ── BRAVE SEARCH ─── TOKEN NEEDED ────────────────────────────────────
    // Get token: api.search.brave.com → subscribe free (2000 req/mo) → copy API key
    "brave-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${env:BRAVE_API_KEY}"
      }
    },

    // ── TELEGRAM ─── TOKEN NEEDED (MTProto userbot) ───────────────────────
    // Enables: read/send any TG chat, groups, channels — NET-PET-AI in TG groups
    // Get tokens: my.telegram.org → API Development Tools → create app
    // → copy api_id (number) and api_hash (hex string)
    // First run will prompt phone + OTP to create session
    "telegram": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@overpod/mcp-telegram"],
      "env": {
        "TELEGRAM_API_ID": "${env:TELEGRAM_API_ID}",
        "TELEGRAM_API_HASH": "${env:TELEGRAM_API_HASH}",
        "TELEGRAM_PHONE": "${env:TELEGRAM_PHONE}"
      }
    },

    // ── LINKEDIN ─── TOKEN NEEDED ─────────────────────────────────────────
    // Enables: post content, read profile, manage connections
    // Get token: linkedin.com/developers → Create App → Products: Share on LinkedIn
    // + Sign In with LinkedIn → OAuth2 → copy Client ID + Client Secret
    // Run first auth: npx linkedin-mcp-server --auth → opens browser, paste callback URL
    "linkedin": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "linkedin-mcp-server"],
      "env": {
        "LINKEDIN_CLIENT_ID": "${env:LINKEDIN_CLIENT_ID}",
        "LINKEDIN_CLIENT_SECRET": "${env:LINKEDIN_CLIENT_SECRET}",
        "LINKEDIN_ACCESS_TOKEN": "${env:LINKEDIN_ACCESS_TOKEN}"
      }
    },

    // ── GMAIL / GOOGLE ─── TOKEN NEEDED ───────────────────────────────────
    // Enables: read/send email, search inbox, draft ops
    // Get token: console.cloud.google.com → new project → Gmail API → OAuth2 credentials
    // → Desktop app → download credentials.json → first run opens browser auth
    "gmail": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"],
      "env": {
        "GMAIL_CREDENTIALS_PATH": "${env:GMAIL_CREDENTIALS_PATH}"
      }
    },

    // ── OUTLOOK / MICROSOFT 365 ─── TOKEN NEEDED ─────────────────────────
    // Enables: 75+ tools — Email (20), Calendar (12), Contacts (8), Tasks (7),
    //          Teams (25), Folder Mgmt (3), Rules (3), Auth (2)
    // Setup:
    //   1. portal.azure.com → App registrations → New registration
    //      Name: "Outlook MCP Server"
    //      Account types: "Accounts in any org directory + personal MS accounts"
    //      Redirect URI: http://localhost:3333/auth/callback
    //   2. API permissions → Microsoft Graph → Delegated:
    //      offline_access, User.Read, Mail.Read, Mail.ReadWrite, Mail.Send,
    //      Calendars.Read, Calendars.ReadWrite, Contacts.Read, Contacts.ReadWrite,
    //      Tasks.Read, Tasks.ReadWrite, Team.ReadBasic.All, Chat.Read, Chat.ReadWrite,
    //      ChatMessage.Read, ChatMessage.Send, Presence.Read, OnlineMeetings.ReadWrite
    //   3. Certificates & secrets → New client secret → copy value
    //   4. Set env vars: MS_CLIENT_ID, MS_CLIENT_SECRET
    //   5. First use: call "authenticate" tool → opens browser for OAuth login
    "outlook": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "outlook-mcp"],
      "env": {
        "MS_CLIENT_ID": "${env:MS_CLIENT_ID}",
        "MS_CLIENT_SECRET": "${env:MS_CLIENT_SECRET}"
      }
    }
  }
}