{
  // NET | Phoenix Rising Protocol — MCP Servers
  // Stack: Cloudflare, GitHub, Notion, Playwright, Chrome, Slack, FS, Brave, Discord
  // Updated: 2026-04-05 | MAX MERGE Build | AnA
  "servers": {
    // ── CLOUDFLARE ───────────────────────────────────────────────────────────────
    "cloudflare": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cloudflare/mcp-server-cloudflare"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${env:CLOUDFLARE_API_TOKEN}",
        "CLOUDFLARE_API_KEY": "${env:CLOUDFLARE_API_KEY}",
        "CLOUDFLARE_EMAIL": "${env:CLOUDFLARE_EMAIL}",
        "CLOUDFLARE_ACCOUNT_ID": "${env:CLOUDFLARE_ACCOUNT_ID}"
      }
    },

    // ── GitHub ───────────────────────────────────────────────────────────────
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "${env:GITHUB_TOKEN}",
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
      }
    },

    // ── NOTION (docs, knowledge base) ───────────────────────────────────────
    "notion": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "{\"Authorization\": \"Bearer ${env:NOTION_TOKEN}\", \"Notion-Version\": \"2022-06-28\"}"
      }
    },

    // ── PLAYWRIGHT (browser automation) ────────────────────────────────
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--headless"]
    },

    // ── CHROME DEVTOOLS (browser debugging) ───────────────────────────────
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp"]
    },

    // ── SLACK (team comms) ────────────────────────────────────────────────
    "slack": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${env:SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${env:SLACK_TEAM_ID}"
      }
    },

    // ── FILESYSTEM (workspace access) ─────────────────────────────────────
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\OB-1"
      ]
    },

    // ── FILESYSTEM (NET-PET-AI scoped) ──────────────────────────────────────
    "filesystem-net-pet-ai": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\OB-1\\APPS\\NET-PET-AI"
      ]
    },

    // ── BRAVE SEARCH (web search) ────────────────────────────────────────────────
    "brave-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${env:BRAVE_API_KEY}"
      }
    },

    // ── DISCORD (community) ────────────────────────────────────────────────
    "discord": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-discord"],
      "env": {
        "DISCORD_TOKEN": "${env:DISCORD_TOKEN}"
      }
    }
  }
}