{
    // NET | Phoenix Rising Protocol — VS Code Workspace Settings
    // Stack: Cloudflare Workers, Node.js, HTML/CSS/JS, Python, PowerShell, MCP
    // Updated: 2026-04 | AnA Build

    // ── File exclusions: keep Explorer clean ──────────────────────────────
    "files.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.venv": true,
        "**/dist": true
    },

    // ── Copilot: exclude massive CANON / archive dirs from AI indexing ────
    // This is the primary fix for Copilot crashing on boot — it was trying to
    // index hundreds of large Markdown files (CANON/, RAW-CHAT-LOGS/, etc.)
    // which exhausted memory during workspace scan.
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    // Enable .github/prompts/*.prompt.md files as /slash commands in Copilot Chat panel
    "chat.promptFiles": true,
    "github.copilot.enable": {
        "*": true
    },

    // ── Search exclusions: speed up workspace searches ────────────────────
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/.venv": true,
        "**/RAW-CHAT-LOGS": true,
        "**/PULSE-HANDOFFS": true,
        "**/ARCHIVE": true,
        "**/OB-1.worktrees": true
    },

    // ── Watcher exclusions: reduce file watcher load ──────────────────────
    // Heavy watcher load is a known cause of Copilot / extension crashes.
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/node_modules/**": true,
        "**/.venv/**": true,
        "**/ARCHIVE/**": true,
        "**/RAW-CHAT-LOGS/**": true,
        "**/PULSE-HANDOFFS/**": true,
        "**/OB-1.worktrees/**": true,
        "**/CANON/VAULT-DUMPS/**": true,
        "**/CANON/REINCARNATION/**": true,
        "**/CANON/SESSION-RECORDS/**": true
    },

    // ── Editor defaults ───────────────────────────────────────────────────
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.renderWhitespace": "boundary",
    "[lua]": {
        "editor.tabSize": 4
    },

    // ── Copilot chat context ──────────────────────────────────────────────
    "github.copilot.chat.scopeSelection": true,

    // ── MCP: set a timeout so failing servers don't hang boot ─────────────
    // Servers requiring missing env vars (NOTION_TOKEN, BRAVE_API_KEY, etc.)
    // will time out instead of blocking Copilot initialisation.
    "mcp": {
        "serverStartTimeout": 10000
    }
}
