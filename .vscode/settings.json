{
    // NET | Phoenix Rising Protocol — VS Code Workspace Settings
    // Stack: Cloudflare Workers, Node.js, HTML/CSS/JS, Python, MCP
    // Updated: 2026-04-02 | AnA Build

    // ── LINK PROTECTION: TRUSTED DOMAINS ────────────────────────────────────
    // Links matching these domains can be opened without link protection prompts.
    // To edit globally, run the "Manage Trusted Domains" command in VS Code.
    // Links matching one or more entries in the list below can be opened without link protection.
    // The following examples show what entries can look like:
    // - "https://microsoft.com": Matches this specific domain using https
    // - "https://microsoft.com:8080": Matches this specific domain on this port using https
    // - "https://microsoft.com:*": Matches this specific domain on any port using https
    // - "https://microsoft.com/foo": Matches https://microsoft.com/foo and https://microsoft.com/foo/bar,
    //   but not https://microsoft.com/foobar or https://microsoft.com/bar
    // - "https://*.microsoft.com": Match all domains ending in "microsoft.com" using https
    // - "microsoft.com": Match this specific domain using either http or https
    // - "*.microsoft.com": Match all domains ending in "microsoft.com" using either http or https
    // - "http://192.168.0.1": Matches this specific IP using http
    // - "http://192.168.0.*": Matches all IP's with this prefix using http
    // - "*": Match all domains using either http or https
    "security.workspace.trust.trustedUris": [
        "*.notion.com",
        "https://spec.modelcontextprotocol.io",
        "https://www.blackbox.ai",
        "https://gitkraken.dev"
    ],

    // ── EDITOR ──────────────────────────────────────────────────────────────
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,

    // ── FILES ────────────────────────────────────────────────────────────────
    "files.eol": "\n",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "[toml]": {
        "editor.defaultFormatter": "tamasfe.even-better-toml"
    },
    "[markdown]": {
        "editor.formatOnSave": false,
        "editor.wordWrap": "on"
    },

    // ── JAVASCRIPT / WORKERS ─────────────────────────────────────────────────
    "javascript.updateImportsOnFileMove.enabled": "always",
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },

    // ── PYTHON ───────────────────────────────────────────────────────────────
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },

    // ── SEARCH / EXPLORER ────────────────────────────────────────────────────
    "search.exclude": {
        "**/node_modules": true,
        "**/.venv": true,
        "**/dist": true,
        "**/.wrangler": true
    },
    "files.exclude": {
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    }
}
