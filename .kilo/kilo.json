{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [".github/agents/*.md", ".kilo/agent/*.md"],
  "default_agent": "AGENT99",
  "snapshot": true,
  "autoupdate": "notify",
  "permission": {
    "bash": "allow",
    "edit": {
      "APPS/**": "allow",
      "CANON/**": "allow",
      "GALAXY-LESSONS/**": "allow",
      "OPERATIONS/**": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "read": "allow"
  }
}