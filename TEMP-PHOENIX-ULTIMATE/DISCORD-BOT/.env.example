# ============================================
# Train 6-7 Discord Bot — Environment Config
# Copy this to .env and fill in real values
# ============================================

# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Discord Application ID
CLIENT_ID=your_client_id_here

# Guild (Server) ID for slash command registration
GUILD_ID=your_guild_id_here

# Channel IDs
WELCOME_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
DROP_ALERTS_CHANNEL_ID=
TRADING_CHANNEL_ID=
BUG_REPORTS_CHANNEL_ID=
GENERAL_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=

# Role IDs
SURVIVOR_ROLE_ID=
VETERAN_ROLE_ID=
RIZZLORD_ROLE_ID=
MOD_ROLE_ID=

# Roblox Game Link
ROBLOX_GAME_URL=https://www.roblox.com/games/YOUR_PLACE_ID

# Update Schedule (cron format — default: every Tuesday 10am ICT)
WEEKLY_UPDATE_CRON=0 3 * * 2

# Timezone
TZ=Asia/Bangkok
